{
  "name": "shadcn-familytree",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://shadcn-family-tree.ryck.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryck/shadcn-familytree.git"
  },
  "bugs": {
    "url": "https://github.com/ryck/shadcn-familytree/issues"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:build": "shadcn build ./registry.json -o apps/web/public/r"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.9.18",
    "typescript": "^6",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
