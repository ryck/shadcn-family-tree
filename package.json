{
  "name": "shadcn-family-tree",
  "version": "0.0.1",
  "private": true,
  "homepage": "https://shadcn-family-tree.ryck.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryck/shadcn-family-tree.git"
  },
  "bugs": {
    "url": "https://github.com/ryck/shadcn-family-tree/issues"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:build": "shadcn build ./registry.json -o apps/web/public/r",
    "ncu": "pnpm dlx npm-check-updates --interactive --format group --cooldown 1d --workspaces --root"
  },
  "devDependencies": {
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "shadcn": "^4.23.1",
    "turbo": "^2.11.13",
    "typescript": "^7",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.0.0"
  }
}
